# ==== Cấu hình LLM cho Medical Chatbot ====
# Copy file này thành `.env` rồi điền giá trị. File `.env` đã nằm trong .gitignore,
# KHÔNG commit nó lên git.

# ollama (mặc định, chạy trên máy) | gemini | auto
#   auto = thử Ollama trước, lỗi thì chuyển Gemini (nếu có key)
LLM_PROVIDER=ollama

# Model local (chỉ dùng khi provider là ollama/auto)
OLLAMA_MODEL=qwen3.5:4b

# --- Phần dưới chỉ cần khi dùng Gemini ---
# Lấy key ở https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model sinh câu trả lời. Để trống = mặc định gemini-3.5-flash.
# (gemini-2.5-* đã ngừng hoạt động, gọi vào sẽ báo 404.)
GEMINI_MODEL=gemini-3.5-flash

# Model rẻ cho bộ lọc chủ đề (chỉ cần trả lời YES/NO trong 8 token)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# off = tắt suy luận (cần cho RAG: max_output_tokens chỉ 400, bật suy luận thì
#       câu trả lời bị cụt hoặc rỗng) | low | auto
GEMINI_THINKING=off
